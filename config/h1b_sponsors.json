  "_metadata": {
    "description": "Well-paying US employers with verified H-1B sponsorship for software-engineering roles. Basis for a 'Top Sponsors' feed filter.",
    "last_updated": "2026-10-26",
    "h1b_source": "DOL LCA disclosure data via h1bdata.info (FY2025; FY2024 where noted). 'swe_lcas' = LCAs with software/developer/engineer titles (lower bound; exact-title count for large filers). 'median_base' = median LCA base salary (excludes bonus/RSU).",
    "pay_source": "levels.fyi US entry-level leaderboard + LCA medians. pay_tier is an estimate of new-grad total comp: S >= ~$250K, A ~ $180-250K, B ~ $130-180K.",
    "match": "See jobflow/sponsors.py. A company matches when its normalized name (legal suffixes stripped) equals an alias, or starts with an alias of 6+ chars / multiple words. 'exact': true disables prefix matching for that entry.",
    "caveats": [
      "LCA filings show history of sponsorship, not a promise for a given role; defense/cleared teams (even at listed firms) may require citizenship.",
      "Since the Sept 2025 proclamation, new H-1B petitions for people outside the US carry a $100K fee; USCIS guidance (Oct 2025) exempts in-US F-1 -> H-1B change of status. Leaving the US while pending can trigger the fee.",
      "IT staffing/consulting firms (Infosys, TCS, Cognizant, Compunnel, etc.) sponsor at high volume but pay far less; they are deliberately excluded."
    ],
    "bonus_profiles": {
      "quant": "Large discretionary annual cash bonus (often 50-100%+ of base) + sign-on; some relocation.",
      "ai_lab": "Large equity grants (RSUs / PPUs) dominate comp; sign-on common.",
      "big_tech": "RSUs (4-yr vest) + sign-on + 10-20% annual bonus target.",
      "growth_tech": "RSUs or private-company options/RSUs + sign-on; cash bonus varies.",
      "bank": "Annual cash bonus; smaller equity. Strong sponsorship pipelines.",
      "hardware": "RSUs + annual bonus; lower base than software-first companies."
    }
  },

